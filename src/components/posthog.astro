    posthog.init('phc_guifuOImHW8dDWapmxp9zRIIC2FAHc7UsTbYlrTsWTr', {
      api_host: 'https://us.i.posthog.com',
      defaults: '2026-01-30',
      // The ClientRouter navigates with history.pushState: one pageview each.
      capture_pageview: 'history_change',
      person_profiles: 'identified_only', // or 'always' to create profiles for anonymous users as well
      // Neither is used here, and each loads its own script.
      disable_session_recording: true,
      disable_surveys: true,
    })

    let loaded = false
    const load = () => {
      if (loaded) return
      loaded = true
      posthog.__load()
    }
    const soon = () =>
      'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 2000 }) : load()
    addEventListener('load', () => setTimeout(soon, 3000), { once: true })
    // In case something holds up the load event.
    setTimeout(load, 8000)
    for (const type of ['pointerdown', 'keydown', 'scroll']) {
      addEventListener(type, load, { once: true, passive: true })
    }

    // The toolbar mounts itself in <body>, which the router replaces on every
    // navigation. Put the same element back once the new body is in, so it
    // keeps its state (and its styles, which belong to this document).
    document.addEventListener('astro:before-swap', event => {
      const toolbar = document.getElementById('__POSTHOG_TOOLBAR__')
      if (!toolbar) return
      const swap = event.swap
      event.swap = () => {
        swap()
        document.body.append(toolbar)
      }
    })
  }
</script>
