---
import Volume from '@tabler/icons/outline/volume.svg'
import VolumeOff from '@tabler/icons/outline/volume-off.svg'
import { ariaLabel } from '@/lib/site'
---

<!-- The sound button shows the current state; CSS picks its icon from
     data-sound on <html>, which the theme script in Layout.astro sets before
     the first paint. -->
<!-- 48px buttons: the minimum touch target, even though the icons are 16px. -->
<div class="flex items-center">
  <button
    id="theme-toggle"
    type="button"
    class="hover:text-foreground flex size-12 items-center justify-center rounded-md transition-colors"
    {...ariaLabel({ pt: 'Tema escuro', en: 'Dark theme' })}
    aria-pressed="false"
    data-foley-hover="tick">
    <!-- mdi:theme-light-dark, the icon the Notion-era site used: one glyph
         for both states, so only aria-pressed changes. -->
    <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M7.5 2c-1.79 1.15-3 3.18-3 5.5s1.21 4.35 3.03 5.5C4.46 13 2 10.54 2 7.5A5.5 5.5 0 0 1 7.5 2m11.57 1.5l1.43 1.43L4.93 20.5L3.5 19.07zm-6.18 2.43L11.41 5L9.97 6l.42-1.7L9 3.24l1.75-.12l.58-1.65L12 3.1l1.73.03l-1.35 1.13zm-3.3 3.61l-1.16-.73l-1.12.78l.34-1.32l-1.09-.83l1.36-.09l.45-1.29l.51 1.27l1.36.03l-1.05.87zM19 13.5a5.5 5.5 0 0 1-5.5 5.5c-1.22 0-2.35-.4-3.26-1.07l7.69-7.69c.67.91 1.07 2.04 1.07 3.26m-4.4 6.58l2.77-1.15l-.24 3.35zm4.33-2.7l1.15-2.77l2.2 2.54zm1.15-4.96l-1.14-2.78l3.34.24zM9.63 18.93l2.77 1.15l-2.53 2.19z"
      ></path>
    </svg>
  </button>
  <button
    id="sound-toggle"
    type="button"
    class="hover:text-foreground flex size-12 items-center justify-center rounded-md transition-colors"
    {...ariaLabel({ pt: 'Sons da interface', en: 'Interface sounds' })}
    aria-pressed="true"
    data-foley-hover="tick">
    <Volume class="size-4" data-sound-icon="on" aria-hidden="true" />
    <VolumeOff class="size-4" data-sound-icon="off" aria-hidden="true" />
  </button>
</div>

<style>
  :global(html[data-sound='off']) [data-sound-icon='on'],
  :global(html:not([data-sound='off'])) [data-sound-icon='off'] {
    display: none;
  }
</style>

<script>
  import { play, set } from '@foleyjs/core'
  import { WebHaptics } from 'web-haptics'

  const haptics = new WebHaptics()
  const root = document.documentElement

  // The footer is re-rendered on every navigation, so it's wired up again on
  // each page load (the router runs this module only once).
  document.addEventListener('astro:page-load', () => {
    const themeButton = document.getElementById('theme-toggle')
    const soundButton = document.getElementById('sound-toggle')
    if (!themeButton || !soundButton) return

    function syncPressed() {
      themeButton!.ariaPressed = String(root.classList.contains('dark'))
      soundButton!.ariaPressed = String(root.dataset.sound !== 'off')
    }
    syncPressed()

    themeButton.addEventListener('click', () => {
      const theme = root.classList.contains('dark') ? 'light' : 'dark'
      root.classList.toggle('dark', theme === 'dark')
      try {
        localStorage.setItem('theme', theme)
      } catch {}
      syncPressed()
      play('switch')
      haptics.trigger('selection')
      ;(window as any).posthog?.capture('theme_switched', { theme })
    })

    soundButton.addEventListener('click', () => {
      const sound = root.dataset.sound === 'off' ? 'on' : 'off'
      root.dataset.sound = sound
      set({ muted: sound === 'off' })
      try {
        localStorage.setItem('sound', sound)
      } catch {}
      syncPressed()
      // Muted, it can't confirm itself; unmuted, it plays to prove it.
      if (sound === 'on') play('on')
      haptics.trigger('selection')
      ;(window as any).posthog?.capture('sound_switched', { sound })
    })
  })
</script>
