---
// Big numbers for a project's result. Use in .mdx:
//   <Stats items={[{ label: 'Performance', before: '77', after: '91' }]} />
// `before` is optional; without it, only the value is shown.
interface Props {
  items: { label: string; before?: string; after: string }[]
}

const { items } = Astro.props
---

<dl class="stats">
  {
    items.map(({ label, before, after }) => (
      <div class="stat">
        <dt>{label}</dt>
        <dd>
          {before && (
            <span class="before">
              {before}
              {' → '}
            </span>
          )}
          <span class="after">{after}</span>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.5rem 1.25rem;
    border-block: 1px solid var(--border);
    padding-block: 1.5rem;
  }
  dt {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  dd {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .before {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .after {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
  }
</style>
