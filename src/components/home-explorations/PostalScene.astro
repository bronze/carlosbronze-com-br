---
// Exploration 4, now live on the home page: the postcard view, reduced to
// its essentials. Pão de Açúcar and Urca in silhouette, as seen from Dona
// Marta, traced from the most photographed view of Rio.
//
// The sky follows the time in Rio (see sky.ts): the sun rises behind the
// hills on the left around 6h, peaks at noon and sets on the right around
// 18h. The moon, in today's phase, takes the same arc for twelve hours, rising
// when its phase says (so a crescent shares the afternoon with the sun). At
// night there are always a few stars, and more when the moon is down.
//
// The weather is Rio's too (see weather.ts): the sun has rays when it's
// clear or partly cloudy, clouds come out with the cloud cover (in front of
// the sun and moon), rain streaks the whole page, a storm now and then
// strikes lightning from a cloud and flashes the page, and stops the cable
// car, and fog sits on the top of Pão de Açúcar. ?tempo=rain forces a sky.
// ?hora=17.5 pins the time. SkyDebug drives it through `sky:control` events
// and listens to `sky:tick`.
import { arc, arcPath, arcPosition, pointOnArc, twilight } from './sky'

interface Props {
  // The page ground follows the hour too (see groundAt in sky.ts).
  daylight?: boolean
}
const { daylight = false } = Astro.props

// Hour marks along the arc, for the sun.
const marks = [6, 9, 12, 15, 18].map(hour => ({
  ...pointOnArc(arcPosition(hour, 6, twilight)!),
  label: `${hour}h`,
}))

// Stars scattered over the sky above the hills, from a fixed seed so they
// don't move between builds. The first few are the ones always out at night.
let seed = 11
const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647
const stars = Array.from({ length: 30 }, (_, i) => ({
  x: 125 + random() * 450,
  y: -65 + random() * 170,
  size: 2 + random() * 2.8,
  twinkle: i % 4 === 0,
  delay: random() * 4,
}))
const fewStars = stars.slice(0, 8)
const moreStars = stars.slice(8)

// The clouds, in the order they come out: the first ones keep clear of the
// sun at its highest. They pass in front of the sun and moon, which stay
// tappable behind them. Each is the clock line's cloud icon (Tabler's), scaled up and
// placed by the middle of its flat bottom. Each holds a bolt, for when
// lightning strikes from it.
const cloudPath =
  'M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.475 2.085 -4.482 4.657 -4.482c.393 -1.762 1.794 -3.2 3.675 -3.773c1.88 -.572 3.956 -.193 5.444 1c1.488 1.19 2.162 3.007 1.77 4.769h.99c1.913 0 3.464 1.56 3.464 3.486c0 1.927 -1.551 3.487 -3.465 3.487z'
const cloudShape = (x: number, y: number, size: number) =>
  `translate(${x} ${y}) scale(${size}) translate(-12 -18)`
const clouds = [
  { x: 505, y: 30, size: 1.9, drift: 22 },
  { x: 195, y: 45, size: 1.7, drift: 27 },
  { x: 285, y: -15, size: 2.5, drift: 30 },
  { x: 430, y: -30, size: 2.2, drift: 24 },
  { x: 365, y: 10, size: 2, drift: 28 },
].map(c => ({
  ...c,
  // Each its own way: how far, which way first, and where in its swing.
  reach: 20 + random() * 20,
  reverse: random() < 0.5,
  delay: random() * c.drift,
}))

// The sun's rays, like the clock line's icon: out when the sky is clear or
// partly cloudy, breathing when it's clear.
const rays = Array.from({ length: 8 }, (_, i) => {
  const angle = (i * Math.PI) / 4
  const [cos, sin] = [Math.cos(angle), Math.sin(angle)]
  return `M${(29 * cos).toFixed(1)} ${(29 * sin).toFixed(1)} L${(37 * cos).toFixed(1)} ${(37 * sin).toFixed(1)}`
}).join(' ')

// Rain: short slanted streaks scattered over the whole page (placed in
// percent of the window, drawn in pixels), each falling a little and fading,
// out of step. A drizzle shows a third of them, a downpour all.
const streaks = Array.from({ length: 150 }, (_, i) => ({
  x: random() * 100,
  y: random() * 100,
  length: 7 + random() * 7,
  tier: i % 3,
  duration: 0.9 + random() * 0.7,
  delay: random() * 1.6,
}))
---

<!-- On a phone the scene sits beside the name, its ground on the baseline of
     "Bronze.": the name ends 238px down at every phone width, and the scene
     is 48vw wide by 247/460 of that tall (25.77vw), so its top is the one
     minus the other, less a few px for the descender room. -->
<svg
  class="scene pointer-events-none absolute top-[calc(234px-25.77vw)] right-4 -z-10 block sm:fixed sm:top-auto sm:right-0 sm:bottom-0 print:hidden w-[48vw] sm:w-[min(55vw,680px)]"
  viewBox="120 -70 460 247"
  aria-hidden="true"
  data-sky
  data-daylight={daylight ? '' : undefined}>
  <!-- The paths, for the debug panel: the sun's, then the moon's. -->
  <g data-sky-path visibility="hidden">
    {[arc.top, arc.moonTop].map(top => (
      <path
        d={arcPath(top)}
        fill="none"
        stroke="var(--outline)"
        stroke-width="1"
        stroke-dasharray="3 4"
        vector-effect="non-scaling-stroke"
      />
    ))}
    {marks.map(m => (
      <>
        <circle cx={m.x} cy={m.y} r="2.5" fill="var(--outline)" />
        <text
          x={m.x}
          y={m.y < arc.horizon - 10 ? m.y - 9 : m.y - 30}
          text-anchor="middle"
          fill="var(--muted-foreground)"
          font-family="var(--font-mono)"
          font-size="9">
          {m.label}
        </text>
      </>
    ))}
  </g>
  <!-- Stars, faded in by the script at night: four-pointed sparkles with a
       soft glow (a blurred copy under each one). -->
  <defs>
    <path
      id="sky-sparkle"
      d="M0 -1 Q0.16 -0.16 1 0 Q0.16 0.16 0 1 Q-0.16 0.16 -1 0 Q-0.16 -0.16 0 -1 Z"></path>
    <filter id="sky-glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="1.4" result="blur"></feGaussianBlur>
      <feComponentTransfer in="blur" result="glow">
        <feFuncA type="linear" slope="0.7"></feFuncA>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode in="glow"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  {[
    { group: 'few', list: fewStars },
    { group: 'more', list: moreStars },
  ].map(({ group, list }) => (
    <g class="fade slow" style="opacity: 0" filter="url(#sky-glow)" data-stars={group}>
      {list.map(s => (
        <use
          href="#sky-sparkle"
          transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)}) scale(${s.size.toFixed(2)})`}
          fill="var(--star)"
          class:list={[s.twinkle && 'twinkle']}
          style={`animation-delay: ${s.delay.toFixed(1)}s`}
        />
      ))}
    </g>
  ))}
  <!-- Placed by the script below, then faded in, so nothing pops or jumps.
       The outer group holds the position; the inner one rises on load. -->
  <g class="fade" style="opacity: 0" data-body="sun">
    <g class="rise">
      <path d={rays} class="rays"></path>
      <circle r="22" fill="var(--sun)"></circle>
    </g>
  </g>
  <g class="fade" style="opacity: 0" data-body="moon">
    <g class="rise">
      <circle r="15" fill="var(--moon-shadow)" stroke="var(--moon-edge)" stroke-width="1"></circle>
      <path fill="var(--moon-lit)" data-moon-lit></path>
    </g>
  </g>
  <g data-weather>
    {clouds.map(c => (
      <g class="fade slow" style="opacity: 0" data-cloud>
        <g
          class="drift"
          style={`--reach: ${c.reach.toFixed(1)}px; animation-duration: ${c.drift}s; animation-delay: -${c.delay.toFixed(1)}s; animation-direction: ${c.reverse ? 'alternate-reverse' : 'alternate'}`}>
          <path
            d={`M${c.x + 3} ${c.y + 1} l-7 16 h8 l-9 20 h7 l-10 24`}
            class="bolt"
            filter="url(#sky-glow)"
            data-bolt
          />
          <path d={cloudPath} transform={cloudShape(c.x, c.y, c.size)} class="cloud" />
        </g>
      </g>
    ))}
  </g>
  <g class="hills">
    <!-- The cable car: its line from the top of Pão de Açúcar to the top of
         Urca, with a small cabin going back and forth on it, as in exploration
         2. Drawn in layers: the cable under both hills, so it comes out from
         behind the dome's shoulder; the cabin over Urca, where it docks in
         view, but under Pão de Açúcar, so it disappears behind the dome on its
         way to the top. The cabin rests at night. -->
    <path
      d="M354 43 Q404 74 450 96"
      fill="none"
      stroke="var(--outline)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"></path>
    <path
      fill="var(--hill)"
      d="M118 176.7 C138 176.4 149.2 172.7 159.9 168.7 C164.2 167.1 176.8 162.4 185.5 159 C194.2 155.6 201.7 151.6 212 148.4 C222.3 145.2 235.6 142.8 247.3 139.6 C259.1 136.3 272.4 132.1 282.7 129 C293 125.8 297.4 123.1 309.2 120.6 C321 118.1 339 116 353.3 114 C367.7 111.9 384.3 110.1 395.3 108.2 C406.3 106.4 411.9 104.7 419.6 102.9 C427.3 101.1 435.8 98.6 441.7 97.6 C447.6 96.6 450.5 96.4 454.9 96.7 C459.4 97.1 463.8 98.1 468.2 99.8 C472.6 101.6 476.7 103.4 481.4 107.3 C486.2 111.3 491.4 118 496.9 123.7 C502.4 129.3 508.7 135.6 514.6 141.3 C520.5 147.1 526 153.3 532.2 158.1 C538.5 162.9 548.8 168.1 552.1 170 C557 172.8 568 176.2 582 176.7 Z"></path>
    <g class="fade" data-cabin>
      <g fill="var(--brand)">
        <path
          d="M0 0 V3.5"
          stroke="var(--brand)"
          stroke-width="1"
          vector-effect="non-scaling-stroke"></path>
        <rect x="-4" y="3.5" width="8" height="5.5" rx="1.2"></rect>
        <animateMotion
          dur="40s"
          repeatCount="indefinite"
          keyPoints="0;1;1;0;0"
          keyTimes="0;0.4;0.5;0.9;1"
          calcMode="spline"
          keySplines="0.45 0 0.55 1; 0 0 1 1; 0.45 0 0.55 1; 0 0 1 1"
          path="M450 96 Q404 74 354 43"></animateMotion>
      </g>
    </g>
    <path
      fill="var(--hill)"
      d="M309.2 121.5 C309.8 118.9 310.7 112.3 312.7 106 C314.8 99.7 318.1 91.3 321.5 83.9 C325 76.6 329.9 67.9 333.5 61.8 C337 55.8 339.8 50.9 342.7 47.7 C345.7 44.5 348.3 43.3 351.1 42.4 C353.9 41.5 356.8 41.7 359.5 42.4 C362.3 43.1 364.8 44.2 367.5 46.8 C370.1 49.5 372.9 54 375.4 58.3 C377.9 62.6 380.3 67.7 382.5 72.9 C384.7 78 386.6 83.3 388.7 89.2 C390.7 95.1 393.8 105 394.9 108.2 L394.9 176.7 L309.2 176.7 Z"></path>
    <!-- Fog: a cloud resting on the summit. -->
    <path
      d={cloudPath}
      transform={cloudShape(352, 58, 3.3)}
      class="cloud fade slow"
      style="opacity: 0"
      data-fog></path>
  </g>
</svg>
<svg
  class="rain pointer-events-none fixed inset-0 -z-10 size-full print:hidden"
  aria-hidden="true"
  data-rain>
  {streaks.map(r => (
    <svg x={`${r.x.toFixed(1)}%`} y={`${r.y.toFixed(1)}%`} overflow="visible">
      <path
        d={`M0 0 l${(-r.length * 0.4).toFixed(1)} ${r.length.toFixed(1)}`}
        class="streak"
        data-tier={r.tier}
        style={`animation-duration: ${r.duration.toFixed(2)}s; animation-delay: -${r.delay.toFixed(2)}s`}
      />
    </svg>
  ))}
</svg>
<!-- Lightning lights up the whole page, over the text too, for a moment. -->
<div
  class="flash pointer-events-none fixed inset-0 z-30 opacity-0 print:hidden"
  aria-hidden="true"
  data-flash></div>

<style>
  .scene,
  .rain {
    --sun: var(--color-brand-300);
    --moon-lit: var(--color-base-300);
    --moon-shadow: transparent;
    --moon-edge: var(--color-base-300);
    --hill: var(--color-base-200);
    /* Pale, or on the light ground they read as specks of dust. */
    --star: var(--color-base-300);
    /* Clouds are the ground's colour with an outline, like the cable: they
       hide the stars behind them, and on the summit they read as a cap. An
       overcast sky fills them grey. */
    --cloud: var(--background);
    --cloud-heavy: var(--color-base-100);
    --rain: var(--color-base-300);
    --bolt: var(--color-brand-500);
  }
  :global(.dark) .scene,
  :global(.dark) .rain {
    --sun: var(--color-brand-700);
    --moon-lit: var(--color-base-300);
    --moon-shadow: var(--color-base-800);
    --moon-edge: transparent;
    --hill: var(--color-base-800);
    --star: var(--color-base-300);
    --cloud-heavy: var(--color-base-900);
    --rain: var(--color-base-700);
    /* Near white, as a real bolt looks against a dark sky. */
    --bolt: var(--color-base-50);
  }
  .cloud {
    fill: var(--cloud);
    stroke: var(--outline);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: fill 1s ease;
  }
  [data-overcast] .cloud {
    fill: var(--cloud-heavy);
  }
  .flash {
    background: oklch(1 0 0 / 0.6);
  }
  :global(.dark) .flash {
    background: oklch(0.9 0 0 / 0.2);
  }
  .streak {
    fill: none;
    stroke: var(--rain);
    stroke-width: 1;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  /* Dry: the whole layer goes, so a page-wide SVG of 150 streaks isn't
     restyled for nothing. */
  .rain[data-rain='0'] {
    display: none;
  }
  [data-rain='1'] .streak:not([data-tier='0']),
  [data-rain='2'] .streak[data-tier='2'] {
    display: none;
  }
  .rays {
    fill: none;
    stroke: var(--sun);
    stroke-width: 2.5;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    transition: opacity 1s ease;
  }
  [data-weather-now='clear'] .rays,
  [data-weather-now='partly'] .rays {
    opacity: 1;
  }
  .bolt {
    fill: none;
    stroke: var(--bolt);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0;
  }
  /* The scene has its own entrance, not the page's rise-in: the hills fade
     in, and the sun or moon fades in while rising a little. */
  .scene {
    animation: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hills {
      animation: sky-fade 1.2s var(--ease-enter) both;
    }
    .rise {
      animation: sky-rise 1.4s var(--ease-enter) 0.2s both;
    }
    .fade {
      transition: opacity 1s ease;
    }
    .slow {
      transition-duration: 1.5s;
    }
    .twinkle {
      animation: twinkle 4s ease-in-out infinite;
    }
    .drift {
      animation: drift 25s ease-in-out infinite alternate;
    }
    .streak {
      animation: fall 1.2s linear infinite;
    }
    [data-weather-now='clear'] .rays {
      animation: breathe 2.4s ease-in-out infinite alternate;
    }
  }
  @keyframes drift {
    from {
      transform: translateX(calc(var(--reach) * -1));
    }
    to {
      transform: translateX(var(--reach));
    }
  }
  @keyframes breathe {
    from {
      transform: scale(0.94);
    }
    to {
      transform: scale(1.08);
    }
  }
  @keyframes fall {
    from {
      opacity: 0;
      transform: translate(2px, -6px);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: translate(-3px, 8px);
    }
  }
  @keyframes sky-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes sky-rise {
    from {
      transform: translateY(14px);
    }
  }
  @keyframes twinkle {
    50% {
      opacity: 0.3;
    }
  }
</style>

<script>
  import {
    arc,
    groundAt,
    hourInRio,
    litMoonPath,
    moonPhase,
    moonRise,
    nightness,
    pointOnArc,
    skyAt,
  } from './sky'
  import { cloudsFor, forceSky, getWeather, lastKnown, type Sky, type Weather } from './weather'

  type Control = { hour?: number | null; phase?: number | null; path?: boolean; sky?: Sky | null }

  document.addEventListener('astro:page-load', () => {
    const found = document.querySelector<SVGSVGElement>('[data-sky]')
    if (!found) return
    const svg = found
    const sun = svg.querySelector<SVGElement>('[data-body="sun"]')!
    const moon = svg.querySelector<SVGElement>('[data-body="moon"]')!
    const lit = svg.querySelector<SVGPathElement>('[data-moon-lit]')!
    const path = svg.querySelector<SVGElement>('[data-sky-path]')!
    const root = document.documentElement
    const daylight = svg.hasAttribute('data-daylight')
    // Ease the ground into its first shade on load, then drop the transition:
    // the minute ticks barely move it, and the dev panel's slider has to
    // repaint it at once, not trail a second behind (the panel itself, on the
    // same token but with no transition, would show the new shade first).
    if (daylight && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.body.style.transition = 'background-color 1s ease'
      setTimeout(() => document.body.style.removeProperty('transition'), 1000)
    }
    const cabin = svg.querySelector<SVGElement>('[data-cabin]')!
    // SMIL ignores prefers-reduced-motion: park the cabin halfway instead.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      svg.pauseAnimations()
      svg.setCurrentTime(8)
    }
    const fewStars = svg.querySelector<SVGElement>('[data-stars="few"]')!
    const moreStars = svg.querySelector<SVGElement>('[data-stars="more"]')!
    const clouds = [...svg.querySelectorAll<SVGElement>('[data-cloud]')]
    const fog = svg.querySelector<SVGElement>('[data-fog]')!
    const rainLayer = document.querySelector<SVGElement>('[data-rain]')!
    const flash = document.querySelector<HTMLElement>('[data-flash]')!
    // Rio's weather: the last one seen, until the new one arrives. With
    // neither, the sun or moon is plain (no rays, no clouds), which fits any
    // weather, so what comes in only adds to it.
    let live: Weather | null = lastKnown()

    // null means "now"; the debug panel can pin either.
    const pinned = Number.parseFloat(new URLSearchParams(location.search).get('hora') ?? '')
    const state: Required<Control> = {
      hour: pinned >= 0 && pinned < 24 ? pinned : null,
      phase: null,
      path: false,
      sky: null,
    }

    function render() {
      const hour = state.hour ?? hourInRio()
      // A pinned phase only changes the moon's shape: it keeps today's rise,
      // so trying phases in the dev panel never takes it out of the sky.
      const phase = state.phase ?? moonPhase()
      const today = moonPhase()
      const rise = moonRise(today)
      const positions = skyAt(hour, today)
      const forced = state.sky ? forceSky(state.sky, live) : live
      // A pinned hour picks the day or night icon by itself.
      const weather =
        forced && state.hour !== null ? { ...forced, isDay: nightness(hour) < 0.5 } : forced
      const { count, overcast } = cloudsFor(weather)
      const rain = weather?.rain ?? 0
      const storm = weather?.sky === 'storm'
      clouds.forEach((cloud, i) => (cloud.style.opacity = i < count ? '1' : '0'))
      fog.style.opacity = weather?.sky === 'fog' ? '1' : '0'
      svg.toggleAttribute('data-overcast', overcast)
      // Not data-sky, which marks the scene for the other scripts.
      if (weather) svg.dataset.weatherNow = weather.sky
      else delete svg.dataset.weatherNow
      rainLayer.dataset.rain = String(rain)
      if (storm !== storming) {
        storming = storm
        thunder(true)
      }
      for (const [body, t, top] of [
        [sun, positions.sun, arc.top],
        [moon, positions.moon, arc.moonTop],
      ] as const) {
        // A body that's down keeps its last spot while it fades out.
        if (t === null) {
          body.style.opacity = '0'
          continue
        }
        const { x, y } = pointOnArc(t, top)
        body.setAttribute('transform', `translate(${x} ${y})`)
        body.style.opacity = '1'
      }
      const shape = litMoonPath(phase, 15)
      lit.setAttribute('d', shape.d)
      lit.setAttribute('transform', shape.mirror ? 'scale(-1 1)' : '')
      if (daylight) {
        const ground = groundAt(hour, root.classList.contains('dark'))
        if (root.style.getPropertyValue('--background') !== ground)
          root.style.setProperty('--background', ground)
      }
      const night = nightness(hour)
      fewStars.style.opacity = String(overcast ? 0 : night)
      // The cable car stops in a storm, as the real one does.
      cabin.style.opacity = String(storm ? 0 : 1 - night)
      moreStars.style.opacity = String(positions.moon === null && !overcast ? night : 0)
      path.setAttribute('visibility', state.path ? 'visible' : 'hidden')
      document.dispatchEvent(
        new CustomEvent('sky:tick', {
          detail: {
            hour,
            phase,
            moonRise: rise,
            live: state.hour === null,
            sky: weather?.sky ?? null,
            weather,
          },
        }),
      )
    }

    function control(event: Event) {
      Object.assign(state, (event as CustomEvent<Control>).detail)
      render()
    }

    // Lightning, now and then in a storm: a bolt from one of the clouds out,
    // and the page flashes twice, quickly, the way a strike lights up a room.
    // The first comes a few seconds in, so a visitor gets to see one; then
    // every 15 to 40 seconds. None with reduced motion.
    let storming = false
    let strike: ReturnType<typeof setTimeout> | undefined
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
    const between = (a: number, b: number) => a + Math.random() * (b - a)
    const lightning = [
      { opacity: 0 },
      { opacity: 1, offset: 0.05 },
      { opacity: 0.1, offset: 0.14 },
      { opacity: 0.8, offset: 0.22 },
      { opacity: 0 },
    ]
    function thunder(first: boolean) {
      clearTimeout(strike)
      if (!storming || reduced) return
      strike = setTimeout(
        () => {
          const out = clouds.filter(cloud => cloud.style.opacity === '1')
          const cloud = out[Math.floor(Math.random() * out.length)]
          cloud
            ?.querySelector('[data-bolt]')!
            .animate(lightning, { duration: 1100, easing: 'ease-out' })
          flash.animate(lightning, { duration: 900, easing: 'ease-out' })
          thunder(false)
        },
        first ? between(3000, 8000) : between(15000, 40000),
      )
    }

    document.addEventListener('sky:control', control)
    // Each tick asks for the weather too; getWeather only goes to the network
    // once its answer is 15 minutes old.
    async function update() {
      live = await getWeather()
      render()
    }
    const timer = setInterval(update, 60_000)
    // The theme toggle swaps the ground's range.
    const theme = new MutationObserver(render)
    theme.observe(root, { attributes: true, attributeFilter: ['class'] })
    document.addEventListener(
      'astro:before-swap',
      () => {
        clearInterval(timer)
        clearTimeout(strike)
        theme.disconnect()
        document.removeEventListener('sky:control', control)
        root.style.removeProperty('--background')
        document.body.style.removeProperty('transition')
      },
      { once: true },
    )
    render()
    update()
  })
</script>
