---
// Exploration 4, now live on the home page: the postcard view, reduced to
// its essentials. Pão de Açúcar and Urca in silhouette, as seen from Dona
// Marta, traced from the most photographed view of Rio.
//
// The sky follows the time in Rio (see sky.ts): the sun rises behind the
// hills on the left around 6h, peaks at noon and sets on the right around
// 18h. The moon, in today's phase, takes the same arc for twelve hours, rising
// when its phase says (so a crescent shares the afternoon with the sun). At
// night there are always a few stars, and more when the moon is down.
// ?hora=17.5 pins the time. SkyDebug drives it through `sky:control` events
// and listens to `sky:tick`.
import { arc, arcPath, arcPosition, pointOnArc, twilight } from './sky'

interface Props {
  // The page ground follows the hour too (see groundAt in sky.ts).
  daylight?: boolean
}
const { daylight = false } = Astro.props

// Hour marks along the arc, for the sun.
const marks = [6, 9, 12, 15, 18].map(hour => ({
  ...pointOnArc(arcPosition(hour, 6, twilight)!),
  label: `${hour}h`,
}))

// Stars scattered over the sky above the hills, from a fixed seed so they
// don't move between builds. The first few are the ones always out at night.
let seed = 11
const random = () => ((seed = (seed * 16807) % 2147483647) / 2147483647)
const stars = Array.from({ length: 30 }, (_, i) => ({
  x: 125 + random() * 450,
  y: -65 + random() * 170,
  size: 2 + random() * 2.8,
  twinkle: i % 4 === 0,
  delay: random() * 4,
}))
const fewStars = stars.slice(0, 8)
const moreStars = stars.slice(8)
---

<svg
  class="scene pointer-events-none absolute top-24 right-4 -z-10 block sm:fixed sm:top-auto sm:right-0 sm:bottom-0 print:hidden w-[48vw] sm:w-[min(55vw,680px)]"
  viewBox="120 -70 460 247"
  aria-hidden="true"
  data-sky
  data-daylight={daylight ? '' : undefined}>
  <!-- The path, for the debug panel -->
  <g data-sky-path visibility="hidden">
    <path
      d={arcPath()}
      fill="none"
      stroke="var(--outline)"
      stroke-width="1"
      stroke-dasharray="3 4"
      vector-effect="non-scaling-stroke"></path>
    {
      marks.map(m => (
        <>
          <circle cx={m.x} cy={m.y} r="2.5" fill="var(--outline)" />
          <text
            x={m.x}
            y={m.y < arc.horizon - 10 ? m.y - 9 : m.y - 30}
            text-anchor="middle"
            fill="var(--muted-foreground)"
            font-family="var(--font-mono)"
            font-size="9">
            {m.label}
          </text>
        </>
      ))
    }
  </g>
  <!-- Stars, faded in by the script at night: four-pointed sparkles with a
       soft glow (a blurred copy under each one). -->
  <defs>
    <path id="sky-sparkle" d="M0 -1 Q0.16 -0.16 1 0 Q0.16 0.16 0 1 Q-0.16 0.16 -1 0 Q-0.16 -0.16 0 -1 Z"></path>
    <filter id="sky-glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="1.4" result="blur"></feGaussianBlur>
      <feComponentTransfer in="blur" result="glow">
        <feFuncA type="linear" slope="0.7"></feFuncA>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode in="glow"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  {
    [
      { group: 'few', list: fewStars },
      { group: 'more', list: moreStars },
    ].map(({ group, list }) => (
      <g class="fade slow" style="opacity: 0" filter="url(#sky-glow)" data-stars={group}>
        {list.map(s => (
          <use
            href="#sky-sparkle"
            transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)}) scale(${s.size.toFixed(2)})`}
            fill="var(--star)"
            class:list={[s.twinkle && 'twinkle']}
            style={`animation-delay: ${s.delay.toFixed(1)}s`}
          />
        ))}
      </g>
    ))
  }
  <!-- Placed by the script below, then faded in, so nothing pops or jumps.
       The outer group holds the position; the inner one rises on load. -->
  <g class="fade" style="opacity: 0" data-body="sun">
    <circle r="22" fill="var(--sun)" class="rise"></circle>
  </g>
  <g class="fade" style="opacity: 0" data-body="moon">
    <g class="rise">
      <circle r="15" fill="var(--moon-shadow)" stroke="var(--moon-edge)" stroke-width="1"></circle>
      <path fill="var(--moon-lit)" data-moon-lit></path>
    </g>
  </g>
  <g class="hills">
    <!-- The cable car: its line from the top of Pão de Açúcar to the top of
         Urca, with a small cabin going back and forth on it, as in exploration
         2. Drawn in layers: the cable under both hills, so it comes out from
         behind the dome's shoulder; the cabin over Urca, where it docks in
         view, but under Pão de Açúcar, so it disappears behind the dome on its
         way to the top. The cabin rests at night. -->
    <path
      d="M354 43 Q404 74 450 96"
      fill="none"
      stroke="var(--outline)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"></path>
    <path fill="var(--hill)" d="M118 176.7 C138 176.4 149.2 172.7 159.9 168.7 C164.2 167.1 176.8 162.4 185.5 159 C194.2 155.6 201.7 151.6 212 148.4 C222.3 145.2 235.6 142.8 247.3 139.6 C259.1 136.3 272.4 132.1 282.7 129 C293 125.8 297.4 123.1 309.2 120.6 C321 118.1 339 116 353.3 114 C367.7 111.9 384.3 110.1 395.3 108.2 C406.3 106.4 411.9 104.7 419.6 102.9 C427.3 101.1 435.8 98.6 441.7 97.6 C447.6 96.6 450.5 96.4 454.9 96.7 C459.4 97.1 463.8 98.1 468.2 99.8 C472.6 101.6 476.7 103.4 481.4 107.3 C486.2 111.3 491.4 118 496.9 123.7 C502.4 129.3 508.7 135.6 514.6 141.3 C520.5 147.1 526 153.3 532.2 158.1 C538.5 162.9 548.8 168.1 552.1 170 C557 172.8 568 176.2 582 176.7 Z"></path>
    <g class="fade" data-cabin>
      <g fill="var(--brand)">
        <path d="M0 0 V3.5" stroke="var(--brand)" stroke-width="1" vector-effect="non-scaling-stroke"></path>
        <rect x="-4" y="3.5" width="8" height="5.5" rx="1.2"></rect>
        <animateMotion
          dur="40s"
          repeatCount="indefinite"
          keyPoints="0;1;1;0;0"
          keyTimes="0;0.4;0.5;0.9;1"
          calcMode="spline"
          keySplines="0.45 0 0.55 1; 0 0 1 1; 0.45 0 0.55 1; 0 0 1 1"
          path="M450 96 Q404 74 354 43"></animateMotion>
      </g>
    </g>
    <path fill="var(--hill)" d="M309.2 121.5 C309.8 118.9 310.7 112.3 312.7 106 C314.8 99.7 318.1 91.3 321.5 83.9 C325 76.6 329.9 67.9 333.5 61.8 C337 55.8 339.8 50.9 342.7 47.7 C345.7 44.5 348.3 43.3 351.1 42.4 C353.9 41.5 356.8 41.7 359.5 42.4 C362.3 43.1 364.8 44.2 367.5 46.8 C370.1 49.5 372.9 54 375.4 58.3 C377.9 62.6 380.3 67.7 382.5 72.9 C384.7 78 386.6 83.3 388.7 89.2 C390.7 95.1 393.8 105 394.9 108.2 L394.9 176.7 L309.2 176.7 Z"></path>
  </g>
</svg>

<style>
  .scene {
    --sun: var(--color-brand-300);
    --moon-lit: var(--color-base-300);
    --moon-shadow: transparent;
    --moon-edge: var(--color-base-300);
    --hill: var(--color-base-200);
    /* Pale, or on the light ground they read as specks of dust. */
    --star: var(--color-base-300);
  }
  :global(.dark) .scene {
    --sun: var(--color-brand-700);
    --moon-lit: var(--color-base-300);
    --moon-shadow: var(--color-base-800);
    --moon-edge: transparent;
    --hill: var(--color-base-800);
    --star: var(--color-base-300);
  }
  /* The scene has its own entrance, not the page's rise-in: the hills fade
     in, and the sun or moon fades in while rising a little. */
  .scene {
    animation: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hills {
      animation: sky-fade 1.2s var(--ease-enter) both;
    }
    .rise {
      animation: sky-rise 1.4s var(--ease-enter) 0.2s both;
    }
    .fade {
      transition: opacity 1s ease;
    }
    .slow {
      transition-duration: 1.5s;
    }
    .twinkle {
      animation: twinkle 4s ease-in-out infinite;
    }
  }
  @keyframes sky-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes sky-rise {
    from {
      transform: translateY(14px);
    }
  }
  @keyframes twinkle {
    50% {
      opacity: 0.3;
    }
  }
</style>

<script>
  import { groundAt, hourInRio, litMoonPath, moonPhase, moonRise, nightness, pointOnArc, skyAt } from './sky'

  type Control = { hour?: number | null; phase?: number | null; path?: boolean }

  document.addEventListener('astro:page-load', () => {
    const svg = document.querySelector<SVGSVGElement>('[data-sky]')
    if (!svg) return
    const sun = svg.querySelector<SVGElement>('[data-body="sun"]')!
    const moon = svg.querySelector<SVGElement>('[data-body="moon"]')!
    const lit = svg.querySelector<SVGPathElement>('[data-moon-lit]')!
    const path = svg.querySelector<SVGElement>('[data-sky-path]')!
    const root = document.documentElement
    const daylight = svg.hasAttribute('data-daylight')
    // Ease the ground into its first shade on load, then drop the transition:
    // the minute ticks barely move it, and the dev panel's slider has to
    // repaint it at once, not trail a second behind (the panel itself, on the
    // same token but with no transition, would show the new shade first).
    if (daylight && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.body.style.transition = 'background-color 1s ease'
      setTimeout(() => document.body.style.removeProperty('transition'), 1000)
    }
    const cabin = svg.querySelector<SVGElement>('[data-cabin]')!
    // SMIL ignores prefers-reduced-motion: park the cabin halfway instead.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      svg.pauseAnimations()
      svg.setCurrentTime(8)
    }
    const fewStars = svg.querySelector<SVGElement>('[data-stars="few"]')!
    const moreStars = svg.querySelector<SVGElement>('[data-stars="more"]')!

    // null means "now"; the debug panel can pin either.
    const pinned = Number.parseFloat(new URLSearchParams(location.search).get('hora') ?? '')
    const state: Required<Control> = {
      hour: pinned >= 0 && pinned < 24 ? pinned : null,
      phase: null,
      path: false,
    }

    function render() {
      const hour = state.hour ?? hourInRio()
      // A pinned phase only changes the moon's face: it keeps today's rise,
      // so the slider doesn't swing it in and out of the sky.
      const rise = moonRise(moonPhase())
      const phase = state.phase ?? moonPhase()
      const positions = skyAt(hour, phase, rise)
      for (const [body, t] of [
        [sun, positions.sun],
        [moon, positions.moon],
      ] as const) {
        // A body that's down keeps its last spot while it fades out.
        if (t === null) {
          body.style.opacity = '0'
          continue
        }
        const { x, y } = pointOnArc(t)
        body.setAttribute('transform', `translate(${x} ${y})`)
        body.style.opacity = '1'
      }
      const shape = litMoonPath(phase, 15)
      lit.setAttribute('d', shape.d)
      lit.setAttribute('transform', shape.mirror ? 'scale(-1 1)' : '')
      if (daylight) {
        const ground = groundAt(hour, root.classList.contains('dark'))
        root.style.setProperty('--background', ground)
      }
      const night = nightness(hour)
      fewStars.style.opacity = String(night)
      cabin.style.opacity = String(1 - night)
      moreStars.style.opacity = String(positions.moon === null ? night : 0)
      path.setAttribute('visibility', state.path ? 'visible' : 'hidden')
      document.dispatchEvent(
        new CustomEvent('sky:tick', {
          detail: { hour, phase, moonRise: rise, live: state.hour === null },
        }),
      )
    }

    function control(event: Event) {
      Object.assign(state, (event as CustomEvent<Control>).detail)
      render()
    }

    document.addEventListener('sky:control', control)
    const timer = setInterval(render, 60_000)
    // The theme toggle swaps the ground's range.
    const theme = new MutationObserver(render)
    theme.observe(root, { attributes: true, attributeFilter: ['class'] })
    document.addEventListener(
      'astro:before-swap',
      () => {
        clearInterval(timer)
        theme.disconnect()
        document.removeEventListener('sky:control', control)
        root.style.removeProperty('--background')
        document.body.style.removeProperty('transition')
      },
      { once: true },
    )
    render()
  })
</script>
