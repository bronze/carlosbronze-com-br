---
import '@/styles/starwind.css'
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import PostHog from '../components/posthog.astro'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

import type { Bilingual } from '@/lib/site'
import { SITE_NAME, baseGraph, descriptions, type JsonLd } from '@/lib/seo'

interface Props {
  title?: Bilingual
  // Search/share snippet. The HTML is PT-first (lang="pt-BR"), so is this.
  description?: string
  // Absolute or root-relative; defaults to the site-wide share card.
  image?: string
  type?: 'website' | 'article' | 'profile'
  // Extra schema.org nodes for this page, next to the site and person.
  jsonLd?: JsonLd[]
  // Keeps the page out of search results (the 404).
  noindex?: boolean
}

const {
  title,
  description = descriptions.pt,
  image = '/og.png',
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props
const full = (t: string) => `${t} · ${SITE_NAME}`
// Home's tab says what the person does; other pages say where you are.
const pageTitle = title ? full(title.pt) : `${SITE_NAME} · Senior Product Manager`
const site = Astro.site!
const path = Astro.url.pathname.replace(/(?<=.)\/$/, '')
const canonical = new URL(path, site).href
const imageUrl = new URL(image, site).href
const graph = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...baseGraph(site), ...jsonLd],
})
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- Preload only what the first screen uses (body text, the mono labels and
         the serif headline), so those files don't queue behind the rest. -->
    <Font cssVariable="--font-geist" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-geist-mono" preload={[{ weight: 400 }]} />
    <Font
      cssVariable="--font-newsreader"
      preload={[{ weight: 500, style: 'normal' }]}
    />
    {
      title ? (
        <title data-title-pt={full(title.pt)} data-title-en={full(title.en)}>
          {pageTitle}
        </title>
      ) : (
        <title>{pageTitle}</title>
      )
    }
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}, Senior Product Manager`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={graph} />
    <SpeedInsights />
    <ClientRouter />
    <script is:inline>
      // Language and theme live on <html>. The router copies the next page's
      // <html> attributes over the current ones, so they're applied to the
      // incoming document before each swap, as well as on the first load.
      function currentLang() {
        try {
          const saved = localStorage.getItem('lang')
          if (saved) return saved
        } catch {}
        return navigator.language.toLowerCase().startsWith('pt') ? 'pt' : 'en'
      }
      function applyLang(doc) {
        const lang = currentLang()
        doc.documentElement.dataset.lang = lang
        doc.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en'
        const title = doc.querySelector('title[data-title-en]')
        if (title && lang === 'en') title.textContent = title.dataset.titleEn
      }

      // Follow the system's light/dark preference, live: changing it (in the
      // OS, or with an extension that overrides prefers-color-scheme) updates
      // the open page. There's no theme toggle, so nothing is stored; the
      // old site's saved choice is cleared so it can't override the system.
      try {
        localStorage.removeItem('colorTheme')
      } catch {}
      const darkQuery = window.matchMedia('(prefers-color-scheme: dark)')
      function applyTheme(doc) {
        doc.documentElement.classList.toggle('dark', darkQuery.matches)
      }

      applyLang(document)
      applyTheme(document)
      darkQuery.addEventListener('change', () => applyTheme(document))
      document.addEventListener('astro:before-swap', event => {
        applyLang(event.newDocument)
        applyTheme(event.newDocument)
      })
    </script>
    <Analytics />
    <PostHog />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="b01a5d15-0458-4258-81f5-705de4b35142"
      is:inline></script>
    <!-- 100% privacy-first analytics -->
    <script
      async
      src="https://scripts.simpleanalyticscdn.com/latest.js"
      is:inline></script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <slot />
  </body>
</html>

<script>
  import { bind, set, unlock } from '@foleyjs/core'

  set({ volume: 1, theme: 'mechanical' })
  // Foley builds its audio engine (an AudioContext plus a generated reverb
  // buffer) on the first tap anywhere, which blocked that tap's paint for
  // ~270ms (INP). Build it while the browser is idle instead: the context
  // starts suspended, and the first tap only has to resume it.
  const warmUp = () => unlock()
  if ('requestIdleCallback' in window)
    requestIdleCallback(warmUp, { timeout: 3000 })
  else setTimeout(warmUp, 1500)
  // Each navigation brings new elements to wire up (bind skips ones it's seen).
  document.addEventListener('astro:page-load', () => bind())
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
  }
</style>
