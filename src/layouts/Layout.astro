---
import '@/styles/starwind.css'
import { Font } from 'astro:assets'
import PostHog from '../components/posthog.astro'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

import type { Bilingual } from '@/lib/site'

interface Props {
  title?: Bilingual
}

const { title } = Astro.props
const full = (t: string) => `${t} · Carlos Bronze`
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-newsreader" preload />
    {
      title ? (
        <title data-title-pt={full(title.pt)} data-title-en={full(title.en)}>
          {full(title.pt)}
        </title>
      ) : (
        <title>Carlos Bronze</title>
      )
    }
    <SpeedInsights />
    <script is:inline>
      try {
        const lang =
          localStorage.getItem('lang') ??
          (navigator.language.toLowerCase().startsWith('pt') ? 'pt' : 'en')
        document.documentElement.dataset.lang = lang
        document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en'
        const title = document.querySelector('title[data-title-en]')
        if (title && lang === 'en') document.title = title.dataset.titleEn
      } catch {}

      // Follow the system's light/dark preference, live: changing it (in the
      // OS, or with an extension that overrides prefers-color-scheme) updates
      // the open page. There's no theme toggle, so nothing is stored; the
      // old site's saved choice is cleared so it can't override the system.
      try {
        localStorage.removeItem('colorTheme')
      } catch {}
      const darkQuery = window.matchMedia('(prefers-color-scheme: dark)')
      function initTheme() {
        document.documentElement.classList.toggle('dark', darkQuery.matches)
      }
      initTheme()
      darkQuery.addEventListener('change', initTheme)
      document.addEventListener('astro:after-swap', initTheme)
    </script>
    <Analytics />
    <PostHog />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="b01a5d15-0458-4258-81f5-705de4b35142"
      is:inline></script>
    <!-- 100% privacy-first analytics -->
    <script
      async
      src="https://scripts.simpleanalyticscdn.com/latest.js"
      is:inline></script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <slot />
  </body>
</html>

<script>
  import { bind, set } from '@foleyjs/core'

  bind()
  set({ volume: 1, theme: 'mechanical' })
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
  }
</style>
