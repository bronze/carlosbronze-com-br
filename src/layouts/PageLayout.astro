---
import Layout from './Layout.astro'
import SiteHeader from '@/components/site/SiteHeader.astro'
import SectionLink from '@/components/site/SectionLink.astro'
import T from '@/components/site/T.astro'
import { ariaLabel, neighbours, sectionFor, type Bilingual } from '@/lib/site'
import type { JsonLd } from '@/lib/seo'

interface Props {
  // Both default to the section's label from src/lib/site.ts.
  eyebrow?: Bilingual
  title?: Bilingual
  // Turns the eyebrow into a link up, e.g. "← EXPERIMENTOS" on a project page.
  back?: { href: string; label: Bilingual }
  heading: Bilingual
  subheading?: Bilingual
  intro?: Bilingual
  // The page's text carries on from the intro (About): one paragraph gap
  // below it instead of a section gap.
  continueIntro?: boolean
  hero?: boolean
  pager?: boolean
  // Search/share snippet; defaults to the intro (PT), then the site's own.
  description?: string
  type?: 'website' | 'article' | 'profile'
  jsonLd?: JsonLd[]
  noindex?: boolean
}

const {
  eyebrow: eyebrowProp,
  title: titleProp,
  back,
  heading,
  subheading,
  intro,
  continueIntro = false,
  hero = false,
  pager = true,
  description,
  type,
  jsonLd,
  noindex,
} = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const { prev, next } = neighbours(path)
const section = sectionFor(path)
const eyebrow = eyebrowProp ?? section!.label
// Home's tab is just the name; other pages get "Section · Carlos Bronze".
const title = path === '/' ? undefined : (titleProp ?? section?.label)
---

<Layout
  title={title}
  description={description ?? (path === '/' ? undefined : intro?.pt)}
  type={type}
  jsonLd={jsonLd}
  noindex={noindex}>
  <a
    href="#main"
    class="bg-foreground text-background sr-only z-50 rounded px-3 py-2 font-mono text-xs focus:not-sr-only focus:fixed focus:top-4 focus:left-4">
    <T pt="Pular para o conteúdo" en="Skip to content" />
  </a>

  <SiteHeader />

  <main
    id="main"
    tabindex="-1"
    class="mx-auto w-full max-w-5xl flex-1 px-4 pt-12 pb-16 outline-none sm:px-6 sm:pt-16">
    <!-- Home uses the full column; inner pages read in a narrower centred one.
         Flat, like alliethu.com: the page's content sits right next to the
         heading, and every block spaces itself with its own margin-bottom.
         The last block's margin is dropped (also when the phone-only pager
         follows it), so the end of the page is the layout's job. -->
    <section
      aria-labelledby="page-title"
      class:list={[
        'reveal [&>:has(+[data-pager])]:mb-0 [&>:last-child]:mb-0',
        !hero && 'mx-auto max-w-[720px]',
      ]}>
      <p
        class="text-muted-foreground mb-5 font-mono text-[13px] tracking-[0.08em] uppercase">
        {
          back ? (
            // On a sub-page the eyebrow doubles as the way back up.
            <a
              href={back.href}
              class="group hover:text-foreground transition-colors"
              data-foley-press="tap"
              data-foley-hover="tick">
              <span
                class="inline-block transition-transform group-hover:-translate-x-1"
                aria-hidden="true">
                ←
              </span>{' '}
              <span class="sr-only">
                <T pt="Voltar para" en="Back to" />{' '}
              </span>
              <T {...back.label} />
            </a>
          ) : (
            <T {...eyebrow} />
          )
        }
      </p>
      <h1
        id="page-title"
        class:list={[
          'mb-6 font-serif font-medium tracking-tight text-balance',
          hero
            ? 'max-w-[8ch] text-6xl leading-[0.92] sm:text-8xl'
            : 'text-[clamp(32px,4vw,46px)] leading-[1.15]',
        ]}>
        <T {...heading} />
      </h1>
      {
        subheading && (
          <p class="text-muted-foreground mb-4 font-mono text-sm">
            <T {...subheading} />
          </p>
        )
      }
      {
        intro && (
          <p
            class:list={[
              'text-foreground/80 text-pretty',
              hero
                ? 'mb-14 max-w-[32ch] text-base leading-relaxed sm:text-lg'
                : 'text-lg leading-[1.75]',
              !hero && (continueIntro ? 'mb-5' : 'mb-11'),
            ]}>
            <T {...intro} />
          </p>
        )
      }

      <slot />

      {
        pager && (
          // Small screens only: on desktop the header nav is always in view,
          // on a phone it has scrolled away by the time you reach the end.
          <nav
            {...ariaLabel({ pt: 'Explorar seções', en: 'Explore sections' })}
            data-pager
            class="mt-11 min-[821px]:hidden">
            <SectionLink
              section={prev}
              direction="prev"
              srPrefix={{ pt: 'Anterior:', en: 'Previous:' }}
              class="border-border min-h-16 border-t py-3.5"
            />
            <SectionLink
              section={next}
              srPrefix={{ pt: 'Próxima:', en: 'Next:' }}
              class="border-border min-h-16 border-t py-3.5"
            />
          </nav>
        )
      }
    </section>
  </main>

  <footer class="text-muted-foreground px-4 pb-8 text-center font-mono text-xs">
    © {new Date().getFullYear()}
  </footer>
</Layout>
