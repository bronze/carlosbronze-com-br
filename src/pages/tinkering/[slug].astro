---
import { getCollection, render } from 'astro:content'
import PageLayout from '@/layouts/PageLayout.astro'
import T from '@/components/site/T.astro'
import { sectionFor } from '@/lib/site'
import { personId } from '@/lib/seo'
import Rows from '@/components/project/Rows.astro'
import Stats from '@/components/project/Stats.astro'
import Steps from '@/components/project/Steps.astro'
import ProjectBody from '@/components/project/ProjectBody.astro'

// Available in every project .mdx without importing.
const components = { Rows, Stats, Steps }

// One page per project folder, with the PT and EN files rendered side by
// side; the language toggle hides one, like everywhere else on the site.
export async function getStaticPaths() {
  const entries = await getCollection('projects')
  const slugs = [...new Set(entries.map(e => e.id.split('/')[0]))]
  return slugs.map(slug => {
    const pt = entries.find(e => e.id === `${slug}/pt`)
    const en = entries.find(e => e.id === `${slug}/en`)
    if (!pt || !en)
      throw new Error(`Project "${slug}" needs both pt.md and en.md`)
    return { params: { slug }, props: { pt, en } }
  })
}

const { pt, en } = Astro.props
const { Content: ContentPt } = await render(pt)
const { Content: ContentEn } = await render(en)
const tinkering = sectionFor('/tinkering')!
const jsonLd = [
  {
    '@type': 'CreativeWork',
    name: pt.data.title,
    alternateName: en.data.title,
    description: pt.data.summary,
    url: new URL(Astro.url.pathname.replace(/\/$/, ''), Astro.site).href,
    // The live project, and its code when there is some.
    sameAs: [pt.data.url, ...(pt.data.repo ? [pt.data.repo] : [])],
    inLanguage: ['pt-BR', 'en'],
    author: { '@id': personId(Astro.site!) },
  },
]
---

<PageLayout
  type="article"
  jsonLd={jsonLd}
  title={{ pt: pt.data.title, en: en.data.title }}
  back={{ href: tinkering.href, label: tinkering.label }}
  heading={{ pt: pt.data.title, en: en.data.title }}
  intro={{ pt: pt.data.summary, en: en.data.summary }}
  continueIntro
  pager={false}>
  <p class="mb-12 flex flex-wrap gap-x-6 text-lg leading-[1.75]">
    {
      [
        { href: pt.data.url, label: { pt: 'ver no ar', en: 'see it live' } },
        pt.data.repo && {
          href: pt.data.repo,
          label: { pt: 'código', en: 'source code' },
        },
      ]
        .filter(l => !!l)
        .map(l => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground underline decoration-current/30 underline-offset-4 transition-colors hover:decoration-brand"
            data-foley-press="tap"
            data-foley-hover="tick">
            <T {...l.label} />
            <span aria-hidden="true">↗</span>
          </a>
        ))
    }
  </p>

  <ProjectBody data-lang-pt>
    <ContentPt components={components} />
  </ProjectBody>
  <ProjectBody data-lang-en>
    <ContentEn components={components} />
  </ProjectBody>
</PageLayout>
