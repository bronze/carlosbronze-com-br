---
import PageLayout from '@/layouts/PageLayout.astro'
import { Image } from 'astro:assets'
import T from '@/components/site/T.astro'
import { projectImage } from '@/lib/project-images'

// Short versions of the notes in obsidian/projetos-pessoais — copy still to be refined.
const projects = [
  {
    name: 'Papo na Arena Radar',
    body: {
      pt: 'Todos os produtos da semana citados no podcast Papo na Arena, organizados em rankings, episódios, categorias e quem recomendou o quê.',
      en: 'Every "product of the week" mentioned on the Papo na Arena podcast, organized into rankings, episodes, categories and who recommended what.',
    },
    href: '/tinkering/papo-na-arena-radar',
  },
  {
    name: 'Rory Sutherland Talks',
    body: {
      pt: 'As palestras do Rory Sutherland estavam espalhadas pelo YouTube. Transcrevi 31 delas e organizei por temas, livros e as histórias que ele repete.',
      en: "Rory Sutherland's talks were scattered across YouTube. I transcribed 31 of them and organized them by topic, book and the stories he keeps retelling.",
    },
    href: '/tinkering/rory-talks',
  },
  {
    name: 'Critical Role Homepage',
    body: {
      pt: 'Achar o que vai ao ar na semana era confuso no site do Critical Role. No redesign, revi a arquitetura de informação para pôr o calendário e as campanhas à mão.',
      en: "Finding what's airing this week on Critical Role's site was confusing. In the redesign, I reworked the information architecture to put the schedule and campaigns within reach.",
    },
    href: '/tinkering/critical-role',
  },
  {
    name: {
      pt: 'Federação Sul Americana de Krav Maga',
      en: 'South American Krav Maga Federation',
    },
    body: {
      pt: 'O site da federação estava lento. Fiz um redesign com Next.js, Nextra e shadcn/ui.',
      en: "The federation's site was slow. I redesigned it with Next.js, Nextra and shadcn/ui.",
    },
    href: '/tinkering/fsakm',
  },
  {
    name: 'Thompson Total Branding',
    body: {
      pt: 'Um manual clássico de planejamento da Thompson, republicado na web com foco em tipografia e navegação.',
      en: 'A classic Thompson planning manual, republished for the web with a focus on typography and navigation.',
    },
    href: '/tinkering/thompson-total-branding',
  },
  {
    name: 'Brandon Sanderson',
    body: {
      pt: 'O site do autor tirava 34 no PageSpeed. Achei que dava pra fazer melhor, então fiz um redesign.',
      en: "The author's site scored 34 on PageSpeed. I thought I could do better, so I redesigned it.",
    },
    // Has its own page (src/content/projects/brandon-sanderson).
    href: '/tinkering/brandon-sanderson',
  },
]

// `live` marks a link to a running site instead of a repo.
const quick: { name: string; nameEn?: string; href: string; live?: boolean }[] = [
  {
    name: 'Mapa das academias de Krav Maga · Mapbox',
    nameEn: 'Krav Maga gym map · Mapbox',
    href: 'https://mapa-kravmaga.carlosbronze.com/',
    live: true,
  },
  {
    name: 'Tera Workshop · Mapbox',
    href: 'https://tera-workshop-dados.carlosbronze.com/',
    live: true,
  },
]

const credit = {
  allie: 'https://alliethu.com/',
  kleon: 'https://austinkleon.com/steal/',
}
const external = { target: '_blank', rel: 'noopener noreferrer' }
const link =
  'text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-brand'
---

<PageLayout
  heading={{
    pt: 'Coisas que fiz por diversão e curiosidade.',
    en: 'Things I built for fun and curiosity.',
  }}
  intro={{
    pt: 'Projetos que nasceram de um incômodo, de uma pergunta ou de uma ideia que não saía da cabeça.',
    en: "Projects that started with an itch, a question, or an idea I couldn't shake.",
  }}>
  <ul class="mb-16 space-y-10">
    {projects.map(p => (
      <li>
        <a
          href={p.href}
          {...(p.href.startsWith('http') && {
            target: '_blank',
            rel: 'noopener noreferrer',
          })}
          class="group grid gap-x-6 gap-y-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:items-start"
          data-foley-press="tap"
          data-foley-hover="tick">
          {(() => {
            // The project as it is now, from src/assets/projects.
            const img = projectImage(p.href.split('/').pop()!)
            return (
              img && (
                <Image
                  src={img}
                  alt=""
                  widths={[416, 720, 1440]}
                  sizes="(min-width: 640px) 208px, 100vw"
                  class="border-border aspect-16/10 w-full rounded-md border object-cover object-top transition-opacity group-hover:opacity-85"
                />
              )
            )
          })()}
          <div>
            <h2 class="mb-2 font-serif text-2xl">
              {typeof p.name === 'string' ? p.name : <T {...p.name} />}{' '}
              <span
                class:list={[
                  'text-muted-foreground group-hover:text-brand inline-block text-base transition-[color,transform]',
                  p.href.startsWith('http')
                    ? 'group-hover:translate-x-0.5 group-hover:-translate-y-0.5'
                    : 'group-hover:translate-x-1',
                ]}
                aria-hidden="true">
                {p.href.startsWith('http') ? '↗' : '→'}
              </span>
            </h2>
            <p class="text-muted-foreground text-base leading-[1.6]">
              <T {...p.body} />
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <section aria-labelledby="quick-title" class="mb-16">
    <h2
      id="quick-title"
      class="text-muted-foreground mb-4 font-mono text-xs tracking-[0.06em] uppercase">
      <T pt="Rapidinhas" en="Quick ones" />
    </h2>
    <ul class="border-border divide-border divide-y border-y">
      {quick.map(q => (
        <li>
          <a
            href={q.href}
            {...(q.href.startsWith('http') && {
              target: '_blank',
              rel: 'noopener noreferrer',
            })}
            class="group flex items-baseline justify-between py-3"
            data-foley-press="tap"
            data-foley-hover="tick">
            <span class="group-hover:decoration-brand group-hover:underline group-hover:underline-offset-4">
              {q.nameEn ? <T pt={q.name} en={q.nameEn} /> : q.name}
            </span>
            <span class="text-muted-foreground font-mono text-xs">
              {q.live ? <T pt="ver no ar" en="see it live" /> : 'repo'}{' '}
              <span
                class="group-hover:text-brand inline-block transition-[color,transform] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true">
                ↗
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Credit for the design. Has inline links, so it can't use <T>. -->
  <section aria-labelledby="colophon-title" class="mb-16">
    <h2
      id="colophon-title"
      class="text-muted-foreground mb-4 font-mono text-xs tracking-[0.06em] uppercase">
      <T pt="Sobre este site" en="About this site" />
    </h2>
    <p class="text-foreground/80 text-base leading-[1.6]">
      <span data-lang-pt>
        Este site é uma homenagem descarada ao
        <a href={credit.allie} {...external} class={link}>
          site da Allie Thu
        </a>
        . A estrutura, o ritmo e as animações vêm de lá; o conteúdo, os erros e as escolhas são
        meus. Como diz o
        <a href={credit.kleon} {...external} class={link}>
          Austin Kleon
        </a>
        : copie, mas dê o crédito. Obrigado, Allie.
      </span>
      <span data-lang-en>
        This site is a shameless homage to
        <a href={credit.allie} {...external} class={link}>
          Allie Thu’s site
        </a>
        . The structure, rhythm and animations come from there; the content, the mistakes and the
        choices are mine. As
        <a href={credit.kleon} {...external} class={link}>
          Austin Kleon
        </a>{' '}
        says: steal like an artist, and credit your sources. Thanks, Allie.
      </span>
    </p>
  </section>
</PageLayout>
