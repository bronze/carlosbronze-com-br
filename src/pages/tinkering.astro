---
import PageLayout from '@/layouts/PageLayout.astro'
import T from '@/components/site/T.astro'

// Short versions of the notes in obsidian/projetos-pessoais — copy still to be refined.
const projects = [
  {
    name: 'Papo na Arena Radar',
    body: {
      pt: 'Todos os produtos da semana citados no podcast Papo na Arena, organizados em rankings, episódios, categorias e quem recomendou o quê.',
      en: 'Every "product of the week" mentioned on the Papo na Arena podcast, organized into rankings, episodes, categories and who recommended what.',
    },
    href: 'https://paponaarena-produtosdasemana.replit.app/',
  },
  {
    name: 'FSAKM',
    body: {
      pt: 'O site da Federação Sul Americana de Krav Maga estava lento. Refiz com Next.js, Nextra e shadcn/ui.',
      en: 'The South American Krav Maga Federation site was slow. I rebuilt it with Next.js, Nextra and shadcn/ui.',
    },
    href: '/tinkering/fsakm',
  },
  {
    name: 'Thompson Total Branding',
    body: {
      pt: 'Um manual clássico de planejamento da Thompson, republicado na web com foco em tipografia e navegação.',
      en: 'A classic Thompson planning manual, republished for the web with a focus on typography and navigation.',
    },
    href: '/tinkering/thompson-total-branding',
  },
  {
    name: 'Brandon Sanderson Redesign',
    body: {
      pt: 'O site do autor tirava 34 no PageSpeed. Achei que dava pra fazer melhor, então tentei.',
      en: "The author's site scored 34 on PageSpeed. I thought I could do better, so I tried.",
    },
    // Has its own page (src/content/projects/brandon-sanderson).
    href: '/tinkering/brandon-sanderson',
  },
]

const quick = [
  {
    name: 'Tera Workshop · Mapbox',
    href: 'https://github.com/bronze/tera-workshop-dados',
  },
  {
    name: 'Este site',
    nameEn: 'This website',
    href: 'https://github.com/bronze/carlosbronze-com-br',
  },
]

const credit = {
  allie: 'https://alliethu.com/',
  kleon: 'https://austinkleon.com/steal/',
}
const external = { target: '_blank', rel: 'noopener noreferrer' }
const link =
  'text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground'
---

<PageLayout
  heading={{
    pt: 'Coisas que fiz por diversão e curiosidade.',
    en: 'Things I built for fun and curiosity.',
  }}
  intro={{
    pt: 'Projetos que nasceram de um incômodo, de uma pergunta ou de uma ideia que não saía da cabeça.',
    en: "Projects that started with an itch, a question, or an idea I couldn't shake.",
  }}>
  <ul class="space-y-10">
    {
      projects.map(p => (
        <li>
          <a
            href={p.href}
            {...(p.href.startsWith('http') && {
              target: '_blank',
              rel: 'noopener noreferrer',
            })}
            class="group block"
            data-foley-press="tap"
            data-foley-hover="tick">
            <h2 class="font-serif text-2xl">
              {p.name}
              <span
                class="text-muted-foreground group-hover:text-foreground text-base transition-colors"
                aria-hidden="true">
                {' '}
                {p.href.startsWith('http') ? '↗' : '→'}
              </span>
            </h2>
            <p class="text-muted-foreground mt-2 text-base leading-[1.6]">
              <T {...p.body} />
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="quick-title" class="mt-16">
    <h2
      id="quick-title"
      class="text-muted-foreground font-mono text-xs tracking-[0.06em] uppercase">
      <T pt="Rapidinhas" en="Quick ones" />
    </h2>
    <ul class="border-border divide-border mt-4 divide-y border-y">
      {
        quick.map(q => (
          <li>
            <a
              href={q.href}
              {...(q.href.startsWith('http') && {
                target: '_blank',
                rel: 'noopener noreferrer',
              })}
              class="group flex items-baseline justify-between py-3"
              data-foley-press="tap"
              data-foley-hover="tick">
              <span class="group-hover:underline group-hover:underline-offset-4">
                {q.nameEn ? <T pt={q.name} en={q.nameEn} /> : q.name}
              </span>
              <span class="text-muted-foreground font-mono text-xs">
                repo <span aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Credit for the design. Has inline links, so it can't use <T>. -->
  <section aria-labelledby="colophon-title" class="mt-16">
    <h2
      id="colophon-title"
      class="text-muted-foreground font-mono text-xs tracking-[0.06em] uppercase">
      <T pt="Sobre este site" en="About this site" />
    </h2>
    <p class="text-foreground/80 mt-4 text-base leading-[1.6]">
      <span data-lang-pt>
        Este site é uma homenagem descarada ao
        <a href={credit.allie} {...external} class={link}>site da Allie Thu</a>.
        A estrutura, o ritmo e as animações vêm de lá; o conteúdo, os erros e as
        escolhas são meus. Como diz o
        <a href={credit.kleon} {...external} class={link}>Austin Kleon</a>:
        copie, mas dê o crédito. Obrigado, Allie.
      </span>
      <span data-lang-en>
        This site is a shameless homage to
        <a href={credit.allie} {...external} class={link}>Allie Thu’s site</a>.
        The structure, rhythm and animations come from there; the content, the
        mistakes and the choices are mine. As
        <a href={credit.kleon} {...external} class={link}>Austin Kleon</a> says: steal
        like an artist, and credit your sources. Thanks, Allie.
      </span>
    </p>
  </section>
</PageLayout>
