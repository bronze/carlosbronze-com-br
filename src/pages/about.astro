---
import PageLayout from '@/layouts/PageLayout.astro'
import T from '@/components/site/T.astro'
import { personId } from '@/lib/seo'

const story = [
  {
    pt: 'Comecei a programar em 1999, criando sites para comunidades de jogos online, e me formei em Desenho Industrial. Jogo e design nunca saíram do meu jeito de pensar produto.',
    en: 'I started coding in 1999, building websites for online gaming communities, and studied industrial design. Games and design never left the way I think about product.',
  },
  {
    pt: 'Depois, no planejamento de agências, aprendi que valor é percepção. Hoje levo isso pro produto: na MySparkle, desenho a gamificação em torno de hábito, com uma north star de streaks definida antes do lançamento.',
    en: 'Then, in agency strategy, I learned that value is perception. Now I bring that to product: at MySparkle, I design gamification around habit, with a streak-based north star set before launch.',
  },
]

const links = {
  krav: 'https://kravmaga.com.br/',
  critrole: 'https://critrole.com/',
  sanderson: 'https://www.brandonsanderson.com/',
  rory: 'https://www.youtube.com/playlist?list=PLGxDladnEAZ1wNjUglLAnDR4nQDAhntKc',
}
const external = { target: '_blank', rel: 'noopener noreferrer' }
// Every paragraph on the page, the intro included (PageLayout), has the same
// 20px below it, like alliethu.com/about. The focus section's own margins
// collapse with it.
const paragraph = 'text-foreground/80 mb-5 text-lg leading-[1.75] text-pretty'
const link =
  'text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-brand'

const focus = [
  {
    title: { pt: 'Estratégia de produto', en: 'Product strategy' },
    body: {
      pt: 'Escolher onde jogar e o que deixar de fora, com uma tese clara de impacto.',
      en: 'Choosing where to play and what to leave out, with a clear thesis of impact.',
    },
  },
  {
    title: {
      pt: 'Métricas que falam com o negócio',
      en: 'Metrics that speak business',
    },
    body: {
      pt: 'Ligar o que o usuário faz ao que a empresa ganha. Número que não muda decisão é decoração.',
      en: "Linking what users do to what the company earns. A number that doesn't change a decision is decoration.",
    },
  },
  {
    title: { pt: 'Narrativa e percepção', en: 'Story & perception' },
    body: {
      pt: 'A história que um produto conta muda o que as pessoas fazem com ele.',
      en: 'The story a product tells changes what people do with it.',
    },
  },
  {
    title: { pt: 'Gamificação', en: 'Gamification' },
    body: {
      pt: 'Design comportamental e mecânicas de jogo como alavanca de hábito e retenção, não como enfeite.',
      en: 'Behavioral design and game mechanics as a lever for habit and retention, not as a gimmick.',
    },
  },
]
---

<PageLayout
  type="profile"
  jsonLd={[
    {
      '@type': 'ProfilePage',
      url: new URL('/about', Astro.site).href,
      mainEntity: { '@id': personId(Astro.site!) },
    },
  ]}
  heading={{
    pt: 'Criatividade em função de resultado.',
    en: 'Creativity in service of results.',
  }}
  intro={{
    pt: 'Sou Carlos Bronze, Senior Product Manager no Rio de Janeiro. Trabalho no encontro entre estratégia, criatividade e produto: entender o que faz o negócio crescer, escolher as métricas que contam essa história e desenhar experiências que fazem esses números mudarem.',
    en: 'I’m Carlos Bronze, a senior product manager based in Rio de Janeiro. I work where strategy, creativity and product meet: understanding what grows the business, choosing the metrics that tell that story, and designing experiences that make those numbers move.',
  }}
  continueIntro>
  {
    story.map(p => (
      <p class={paragraph}>
        <T {...p} />
      </p>
    ))
  }

  <section aria-labelledby="focus-title" class="mt-10 mb-11">
    <h2
      id="focus-title"
      class="text-muted-foreground mb-5 font-mono text-xs tracking-[0.06em] uppercase">
      <T pt="Onde eu foco" en="Where I focus" />
    </h2>
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(148px,1fr))] gap-x-[22px] gap-y-6">
      {
        focus.map(f => (
          <div>
            <h3 class="mb-1.5 font-serif text-lg leading-snug">
              <T {...f.title} />
            </h3>
            <p class="text-muted-foreground text-sm leading-normal">
              <T {...f.body} />
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <p class={paragraph}>
    <T
      pt="A essa altura, já são quase 20 anos pensando em produtos digitais e marcas, de agência a startup. As ferramentas mudaram muito, mas a pergunta por trás continua a mesma: como criar uma experiência boa o bastante para fazer as pessoas voltarem?"
      en="By now, I’ve spent almost 20 years thinking about digital products and brands, from agencies to startups. The tools have changed a lot, but the question behind them is still the same: how do you build an experience good enough to make people come back?"
    />
  </p>

  <!-- Has inline links, so it can't use <T>; the data-lang-* spans follow the same toggle. -->
  <p class={paragraph}>
    <span data-lang-pt>
      Fora do trabalho, treino <a href={links.krav} {...external} class={link}
        >Krav Maga</a
      >, assisto muito <a href={links.critrole} {...external} class={link}
        >Critical Role</a
      >, leio bastante (sou muito fã do
      <a href={links.sanderson} {...external} class={link}>Brandon Sanderson</a
      >) e ando maratonando <a href={links.rory} {...external} class={link}
        >vídeos do Rory Sutherland</a
      > no YouTube.
    </span>
    <span data-lang-en>
      Outside work, I train <a
        href={links.krav}
        {...external}
        class={link}>Krav Maga</a
      >, watch a lot of <a href={links.critrole} {...external} class={link}
        >Critical Role</a
      >, read a bunch (big
      <a href={links.sanderson} {...external} class={link}>Brandon Sanderson</a> fan),
      and have been binging <a href={links.rory} {...external} class={link}
        >Rory Sutherland videos</a
      >
      on YouTube.
    </span>
  </p>

  <!-- Each language points at its own CV; click tracking is wired by SiteHeader's [data-track] handler. -->
  <p class={paragraph}>
    <span data-lang-pt>
      Quer a versão completa? Meu <a
        href="/obsidian/curriculo"
        class={link}
        data-track="resume_clicked">currículo</a
      > está aqui.
    </span>
    <span data-lang-en>
      Want the full version? My <a
        href="/obsidian/resume"
        class={link}
        data-track="resume_clicked">resume</a
      > is here.
    </span>
  </p>
</PageLayout>
