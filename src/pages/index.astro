---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <main
    class="bg-background text-foreground flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-6">
      <div class="space-y-3">
        <h1 class="text-2xl font-semibold tracking-tight">Carlos Bronze</h1>

        <div class="text-muted-foreground flex items-center gap-1 text-xs">
          <button
            id="btn-pt"
            class="lang-btn rounded px-2 py-0.5 font-medium transition-colors"
            data-lang="pt"
            data-foley-press="tick">PT</button
          >
          <span class="opacity-30">/</span>
          <button
            id="btn-en"
            class="lang-btn rounded px-2 py-0.5 font-medium transition-colors"
            data-lang="en"
            data-foley-press="tick">EN</button
          >
        </div>

        <p
          id="tagline-pt"
          class="text-muted-foreground lang-text text-sm leading-relaxed">
          Ajudo lideranças e times de produto a transformar ambiguidade em
          direção clara. Conectando visão, métricas e entrega para gerar impacto
          mensurável.
        </p>
        <p
          id="tagline-en"
          class="text-muted-foreground lang-text hidden text-sm leading-relaxed">
          I help product leaders and teams turn ambiguity into clear direction.
          Connecting vision, metrics, and delivery to drive measurable impact.
        </p>
      </div>

      <div class="bg-border h-px"></div>

      <div class="space-y-2">
        <a
          href="/obsidian"
          data-foley-press="tap"
          data-foley-hover="tick"
          class="border-border bg-card hover:bg-accent hover:text-accent-foreground flex w-full items-center justify-between rounded-md border px-4 py-3 text-sm font-medium shadow-sm transition-colors">
          <span>Obsidian Notes</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { bind, set } from '@foleyjs/core'

  bind()
  set({ volume: 0.5, theme: 'glass' })

  const btns = document.querySelectorAll<HTMLButtonElement>('.lang-btn')
  const taglinePt = document.getElementById('tagline-pt')!
  const taglineEn = document.getElementById('tagline-en')!

  function setLang(lang: string) {
    taglinePt.classList.toggle('hidden', lang !== 'pt')
    taglineEn.classList.toggle('hidden', lang !== 'en')
    btns.forEach(b => {
      const active = b.dataset.lang === lang
      b.classList.toggle('text-foreground', active)
      b.classList.toggle('text-muted-foreground', !active)
    })
    localStorage.setItem('lang', lang)
  }

  const saved = localStorage.getItem('lang')
  const detected = navigator.language.toLowerCase().startsWith('pt')
    ? 'pt'
    : 'en'
  setLang(saved ?? detected)

  btns.forEach(b =>
    b.addEventListener('click', () => {
      const lang = b.dataset.lang!
      setLang(lang)
      ;(window as any).posthog?.capture('language_switched', { language: lang })
    }),
  )

  document
    .querySelector('a[href="/obsidian"]')
    ?.addEventListener('click', () => {
      ;(window as any).posthog?.capture('obsidian_link_clicked')
    })
</script>
