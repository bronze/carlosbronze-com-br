---
import PageLayout from '@/layouts/PageLayout.astro'
import SectionLink from '@/components/site/SectionLink.astro'
import PostalScene from '@/components/home-explorations/PostalScene.astro'
import { ariaLabel, sections } from '@/lib/site'
---

<PageLayout
  hero
  eyebrow={{ pt: 'Rio de Janeiro, BR', en: 'Rio de Janeiro, BR' }}
  heading={{ pt: 'Carlos Bronze.', en: 'Carlos Bronze.' }}
  subheading={{ pt: 'Senior Product Manager', en: 'Senior Product Manager' }}
  intro={{
    pt: 'Conecto estratégia, métricas e criatividade para construir produtos que movem o negócio.',
    en: 'I connect strategy, metrics and creativity to build products that move the business.',
  }}
  pager={false}>
  <!-- Same copy as `intro`, with a forced break in EN. -->
  <Fragment slot="intro">
    <span data-lang-pt>Conecto estratégia, métricas e criatividade para construir produtos que movem o negócio.</span><span data-lang-en>I connect strategy, metrics and creativity<br /> to build products that move the business.</span>
  </Fragment>
  <nav {...ariaLabel({ pt: 'Seções', en: 'Sections' })}>
    <ul class="grid max-w-3xl gap-x-10 gap-y-6 sm:grid-cols-3">
      {
        sections.map(s => (
          <li>
            <SectionLink section={s} />
          </li>
        ))
      }
    </ul>
  </nav>
  <!-- Pão de Açúcar with the sky of the hour in Rio (exploration 4). -->
  <PostalScene />
</PageLayout>
