{
  "buildCommand": "pnpm run build",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Clacks-Overhead",
          "value": "GNU Terry Pratchett"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/obsidian/",
      "destination": "https://publish.obsidian.md/serve?url=www.carlosbronze.com.br/obsidian"
    },
    {
      "source": "/obsidian/:path*",
      "destination": "https://publish.obsidian.md/serve?url=www.carlosbronze.com.br/obsidian/:path*"
    }
  ]
}
